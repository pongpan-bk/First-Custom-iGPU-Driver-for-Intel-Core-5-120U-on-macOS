# Makefile MyIntelGPU.kext
#
# Build on macOS:
#    - Xcode Command Line Tools (xcode-select --install)
#    - MacKernelSDK (https://github.com/acidanthera/MacKernelSDK)
#
# build:
#    make
#    make opencore
#    make pkg

TARGET  = MyIntelGPU
CLASS   = MyIntelGPU

# ─── Pure Native Driver Mode ──────────────────────────────────────
# No Lilu. kext is a standalone IOService driver only.
SDK_DIR ?= $(HOME)/MacKernelSDK
ifneq ($(KERNEL_SDK_DIR),)
    SDK_DIR := $(KERNEL_SDK_DIR)
endif
ifeq ($(wildcard $(SDK_DIR)/Headers/IOKit/IOService.h),)
    ifneq ($(wildcard /opt/MacKernelSDK/Headers/IOKit/IOService.h),)
        SDK_DIR := /opt/MacKernelSDK
    else
        SDK_DIR := $(shell xcrun --show-sdk-path 2>/dev/null)
    endif
endif

ifeq ($(wildcard $(SDK_DIR)/Headers/IOKit/IOService.h),)
    USE_MKS :=
    SDK_XCRUN := $(SDK_DIR)
else
    USE_MKS := 1
    SDK_XCRUN := $(shell xcrun --show-sdk-path 2>/dev/null)
endif

# ─── Version Stamping ─────────────────────────────────────────────
BASE_VERSION := $(shell /usr/libexec/PlistBuddy -c "Print :CFBundleVersion" Info.plist 2>/dev/null)
BASE_VERSION_OK := $(shell printf '%s' "$(BASE_VERSION)" | grep -cE '^[0-9]+(\.[0-9]+)*$$')
ifeq ($(BASE_VERSION_OK),0)
$(error FATAL: cannot read CFBundleVersion from Info.plist (got '$(BASE_VERSION)'). Fix the plist first.)
endif

GIT_COMMITS  := $(shell git rev-list --count HEAD 2>/dev/null || echo 0)
ifneq ($(GIT_COMMITS),0)
    BUILD_NUMBER := $(GIT_COMMITS)
else
    BUILD_NUMBER := $(shell date +%H%M)
endif
STAMPED_VERSION := $(shell echo "$(BASE_VERSION).0.0" | awk -F. '{m=$$1?$$1:1; n=$$2?$$2:0; print m"."n}').$(BUILD_NUMBER)

MyIntelGPUVersion.h: FORCE
	@printf '/* Generated by Makefile from CFBundleVersion - do not edit. */\n#pragma once\n#define MYINTELGPU_BUNDLE_VERSION "%s"\n' "$(STAMPED_VERSION)" > $@.tmp
	@cmp -s $@.tmp $@ || mv $@.tmp $@
	@rm -f $@.tmp

# ─── Compiler Flags ───────────────────────────────────────────────
ifeq ($(USE_MKS),1)
KERNEL_HEADERS   = -I$(SDK_DIR)/Headers \
                   -I$(SDK_XCRUN)/usr/include
KMOD_LIB         = $(SDK_DIR)/Library/x86_64/libkmod.a
else
KERNEL_HEADERS   = -I$(SDK_XCRUN)/System/Library/Frameworks/Kernel.framework/Headers \
                   -I$(SDK_XCRUN)/usr/include
KMOD_LIB         =
endif

CXXFLAGS = -std=c++14 \
           -mkernel \
           -fapple-kext \
           -mmacosx-version-min=12.0 \
           -arch x86_64 \
           -Oz \
           -flto \
           -ffunction-sections \
           -fdata-sections \
           -nostdlib \
           -fno-builtin \
           -fno-exceptions \
           -fno-rtti \
           -fno-stack-protector \
           -fno-unwind-tables \
           -fno-asynchronous-unwind-tables \
           -fomit-frame-pointer \
           -D_FORTIFY_SOURCE=0 \
           -DKERNEL \
           -D__STRICT_BSD__ \
           -Wno-deprecated-declarations \
           -Wno-inconsistent-missing-override \
           $(KERNEL_HEADERS)

# ─── Linker Flags ─────────────────────────────────────────────────
LDFLAGS = -flto \
          -Xlinker -kext \
          -Xlinker -dead_strip \
          -Xlinker -x \
          -Xlinker -exported_symbols_list \
          -Xlinker $(CURDIR)/exported_symbols.txt

# ─── Sources (Pure Native - 9 TUs, no Lilu, no Bundle) ────────────
SRC = MyIntelGPU.cpp IntelFramebuffer.cpp MyIntelFramebuffer.cpp \
      MyIntelMedia.cpp \
      MyIntelRing.cpp MyIntelGEMBuffer.cpp MyIntelGPUClient.cpp \
      MyIntelVCSClient.cpp \
      MyIntelEDIDParser.cpp

OBJ = MyIntelGPU.o IntelFramebuffer.o MyIntelFramebuffer.o MyIntelMedia.o \
      MyIntelRing.o MyIntelGEMBuffer.o MyIntelGPUClient.o \
      MyIntelVCSClient.o \
      MyIntelEDIDParser.o

.PHONY: all clean install load unload log lint format version strip_binary sizecheck FORCE myintel-decode pkg opencore
.DEFAULT_GOAL := all

all: $(TARGET).kext/Contents/MacOS/$(TARGET)

# ─── Userspace H.264 application frontend (Layer 1) ───────────────
USER_DECODE_DIR = build/myintel-decode
USER_DECODE_OBJS = $(USER_DECODE_DIR)/myintel-decode.o \
                   $(USER_DECODE_DIR)/myintelvcs_bridge.o \
                   $(USER_DECODE_DIR)/MyIntelVCSCommand.o

myintel-decode: $(USER_DECODE_DIR)/myintel-decode

test-vcs-pipeline:
	mkdir -p build
	clang++ -std=c++14 -O2 -Wall -Wextra -I VCSMediaHarness \
	  -o build/test-vcs-pipeline-kernel-builder VCSMediaHarness/test_pipeline_init.cpp MyIntelVCSCommand.cpp
	clang++ -std=c++14 -O2 -Wall -Wextra -I VCSMediaHarness \
	  -o build/test-vcs-pipeline-harness-builder VCSMediaHarness/test_pipeline_init.cpp \
	  VCSMediaHarness/MyIntelVCSCommand.cpp
	build/test-vcs-pipeline-kernel-builder
	build/test-vcs-pipeline-harness-builder

$(USER_DECODE_DIR):
	mkdir -p "$@"

$(USER_DECODE_DIR)/myintel-decode.o: myintel-decode.c \
                                    VCSMediaHarness/myintel_vcs_user.h \
                                    VCSMediaHarness/myintelvcs_bridge.h \
                                    VCSMediaHarness/myintel_h264_parse.h \
                                    VCSMediaHarness/myintel_hevc_parse.h | $(USER_DECODE_DIR)
	clang -std=c11 -O2 -Wall -Wextra -I VCSMediaHarness -c -o "$@" "$<"

$(USER_DECODE_DIR)/myintelvcs_bridge.o: VCSMediaHarness/myintelvcs_bridge.c \
                                        VCSMediaHarness/myintelvcs_bridge.h \
                                        VCSMediaHarness/myintel_vcs_user.h \
                                        VCSMediaHarness/myintel_h264_parse.h \
                                        VCSMediaHarness/myintel_hevc_parse.h \
                                        VCSMediaHarness/MyIntelVCS.h \
                                        VCSMediaHarness/MyIntelVCSCommand.h | $(USER_DECODE_DIR)
	clang -std=c11 -O2 -I VCSMediaHarness -c -o "$@" "$<"

$(USER_DECODE_DIR)/MyIntelVCSCommand.o: VCSMediaHarness/MyIntelVCSCommand.cpp \
                                        VCSMediaHarness/MyIntelVCSCommand.h | $(USER_DECODE_DIR)
	clang++ -std=c++14 -O2 -I VCSMediaHarness -c -o "$@" "$<"

$(USER_DECODE_DIR)/myintel-decode: $(USER_DECODE_OBJS)
	clang++ -o "$@" $(USER_DECODE_OBJS) \
	  -framework IOKit -framework CoreFoundation -framework Foundation

# ─── Compile ──────────────────────────────────────────────────────
$(OBJ): MyIntelGPUVersion.h

%.o: %.cpp
	$(CC) $(CXXFLAGS) -c -o $@ $<

# ─── Link (Pure Kext - No PlugIns Bundle) ─────────────────────────
$(TARGET).kext/Contents/Info.plist: Info.plist FORCE
	mkdir -p "$(TARGET).kext/Contents"
	cp Info.plist "$@"
	/usr/libexec/PlistBuddy -c "Set :CFBundleVersion $(STAMPED_VERSION)" "$@"
	@echo "   version stamped: $(STAMPED_VERSION)"

$(TARGET).kext/Contents/MacOS/$(TARGET): $(OBJ) $(TARGET).kext/Contents/Info.plist
	mkdir -p "$(TARGET).kext/Contents/MacOS"
	rm -rf "$(TARGET).kext/Contents/PlugIns"
	$(CC) $(CXXFLAGS) $(LDFLAGS) -o "$@" $(OBJ) $(if $(wildcard $(KMOD_LIB)),$(KMOD_LIB))
	strip -x -S "$@"
	ls -la "$(TARGET).kext/Contents/MacOS/"
	@actual=$$(stat -f%z "$@"); \
	if [ "$$actual" -gt 230000 ]; then \
		echo "ERROR: binary $$actual bytes > 230000 budget - build rejected"; exit 1; \
	else \
		echo "--- Build complete: $(TARGET).kext  [$(STAMPED_VERSION)]  $$actual bytes (<=230000) ---"; \
	fi

# ─── Utilities ────────────────────────────────────────────────────
OC_STAGE = build/opencore-stage

clean:
	rm -rf $(TARGET).kext $(OBJ) MyIntelGPUVersion.h $(USER_DECODE_DIR) $(OC_STAGE) $(TARGET)-OpenCore-*.zip

install: all
	sudo chown -R root:wheel $(TARGET).kext
	sudo cp -R $(TARGET).kext /Library/Extensions/
	sudo kextutil -v /Library/Extensions/$(TARGET).kext

load: all
	sudo chown -R root:wheel $(TARGET).kext
	sudo kextutil -v $(TARGET).kext

unload:
	sudo kextunload -b com.pongpan-bk.MyIntelGPU || true

log:
	sudo dmesg | grep -i "MyIntelGPU" | tail -50

version:
	@echo "Base version : $(BASE_VERSION)"
	@echo "Git commits  : $(GIT_COMMITS)"
	@echo "Stamped      : $(STAMPED_VERSION)"

# ─── Code Quality ─────────────────────────────────────────────────
FORMAT_SOURCES = $(filter-out MyIntelGPUVersion.h,$(wildcard *.c *.cc *.cpp *.h *.hpp *.m *.mm *.metal))
FORMAT_SOURCES += $(wildcard VCSMediaHarness/*.c VCSMediaHarness/*.cc \
                           VCSMediaHarness/*.cpp VCSMediaHarness/*.h \
                           VCSMediaHarness/*.hpp VCSMediaHarness/*.m \
                           VCSMediaHarness/*.mm VCSMediaHarness/*.metal)

lint:
	clang-tidy --checks="*" --warnings-as-errors="*" \
	  MyIntelGPU.cpp IntelFramebuffer.cpp MyIntelFramebuffer.cpp \
	  MyIntelRing.cpp MyIntelGEMBuffer.cpp -- \
	  $(CXXFLAGS) 2>&1 || echo "Warning: clang-tidy not installed - skipping"

format:
	clang-format -style=file -i $(FORMAT_SOURCES)

# ─── Installer package (.pkg) ─────────────────────────────────────
PKG_STAGE   = build/pkg-stage
PKG_NAME    := $(TARGET)-pkg.pkg

pkg: $(TARGET).kext/Contents/MacOS/$(TARGET)
	@echo "--- Staging package tree ---"
	@rm -rf "$(PKG_STAGE)"
	@mkdir -p "$(PKG_STAGE)/Library/Extensions"
	@cp -R "$(TARGET).kext" "$(PKG_STAGE)/Library/Extensions/"
	@rm -rf "$(PKG_STAGE)/Library/Extensions/$(TARGET).kext/Contents/PlugIns"
	@chown -R root:wheel "$(PKG_STAGE)/Library/Extensions/$(TARGET).kext" 2>/dev/null || true
	@chmod -R 755 "$(PKG_STAGE)/Library/Extensions/$(TARGET).kext"
	@find "$(PKG_STAGE)/Library/Extensions/$(TARGET).kext" -name '.DS_Store' -delete
	@codesign -s - --force "$(PKG_STAGE)/Library/Extensions/$(TARGET).kext" 2>/dev/null || true
	@PKG_VERSION=$$(/usr/libexec/PlistBuddy -c "Print :CFBundleVersion" "$(PKG_STAGE)/Library/Extensions/$(TARGET).kext/Contents/Info.plist") && \
	 PKG_NAME="$(TARGET)-$$PKG_VERSION.pkg" && \
	 echo "--- Building $$PKG_NAME ---" && \
	 pkgbuild --root "$(PKG_STAGE)/Library" \
	          --identifier com.pongpan-bk.$(TARGET) \
	          --version "$$PKG_VERSION" \
	          --install-location "/Library" \
	          --scripts packaging \
	          --ownership preserve \
	          "$$PKG_NAME" && \
	 ls -lh "$$PKG_NAME" && \
	 echo "Built $$PKG_NAME"

# ─── OpenCore EFI Full Suite (No Bundle, ICL Hook, 0xA7AC) ────────
opencore: $(TARGET).kext/Contents/MacOS/$(TARGET)
	@echo "--- Staging OpenCore EFI suite ---"
	@rm -rf "$(OC_STAGE)"
	@mkdir -p "$(OC_STAGE)/EFI/OC/Kexts" "$(OC_STAGE)/EFI/OC/ACPI"
	@cp -R "$(TARGET).kext" "$(OC_STAGE)/EFI/OC/Kexts/$(TARGET).kext"
	@rm -rf "$(OC_STAGE)/EFI/OC/Kexts/$(TARGET).kext/Contents/PlugIns"
	@find "$(OC_STAGE)" -name '.DS_Store' -delete
	@xattr -cr "$(OC_STAGE)/EFI/OC/Kexts/$(TARGET).kext" 2>/dev/null || true
	@codesign -s - --force "$(OC_STAGE)/EFI/OC/Kexts/$(TARGET).kext" 2>/dev/null || true
	@printf '%s\n' \
	  'DefinitionBlock ("", "SSDT", 2, "PONGPN", "MYIGPU", 0x00001000)' \
	  '{' \
	  '    External (_SB_.PC00.GFX0, DeviceObj)' \
	  '    Scope (\_SB.PC00.GFX0)' \
	  '    {' \
	  '        Method (_DSM, 4, NotSerialized)' \
	  '        {' \
	  '            If ((Arg2 == Zero)) { Return (Buffer (One) { 0x03 }) }' \
	  '            Return (Package (0x06)' \
	  '            {' \
	  '                "device-id", Buffer (0x04) { 0xAC, 0xA7, 0x00, 0x00 },' \
	  '                "model", Buffer () { "Intel(R) Graphics" },' \
	  '                "device_type", Buffer () { "VGA compatible controller" }' \
	  '            })' \
	  '        }' \
	  '    }' \
	  '}' > "$(OC_STAGE)/EFI/OC/ACPI/SSDT-MyIntelGPU.dsl"
	@if command -v iasl >/dev/null 2>&1; then \
		iasl -oa "$(OC_STAGE)/EFI/OC/ACPI/SSDT-MyIntelGPU.dsl" && \
		echo "Compiled SSDT-MyIntelGPU.aml"; \
	fi
	@printf '%s\n' \
	  '<?xml version="1.0" encoding="UTF-8"?>' \
	  '<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">' \
	  '<plist version="1.0">' \
	  '<dict>' \
	  '	<key>ACPI</key>' \
	  '	<dict>' \
	  '		<key>Add</key>' \
	  '		<array>' \
	  '			<dict>' \
	  '				<key>Comment</key>' \
	  '				<string>Optional ACPI properties for Intel Core 5 120U iGPU (0xA7AC)</string>' \
	  '				<key>Enabled</key>' \
	  '				<false/>' \
	  '				<key>Path</key>' \
	  '				<string>SSDT-MyIntelGPU.aml</string>' \
	  '			</dict>' \
	  '		</array>' \
	  '	</dict>' \
	  '	<key>DeviceProperties</key>' \
	  '	<dict>' \
	  '		<key>Add</key>' \
	  '		<dict>' \
	  '			<key>PciRoot(0x0)/Pci(0x2,0x0)</key>' \
	  '			<dict>' \
	  '				<key>device_type</key>' \
	  '				<string>VGA compatible controller</string>' \
	  '				<key>model</key>' \
	  '				<string>Intel(R) Graphics</string>' \
	  '				<key>device-id</key>' \
	  '				<data>rKcAAA==</data>' \
	  '			</dict>' \
	  '		</dict>' \
	  '	</dict>' \
	  '	<key>Kernel</key>' \
	  '	<dict>' \
	  '		<key>Add</key>' \
	  '		<array>' \
	  '			<dict>' \
	  '				<key>Arch</key>' \
	  '				<string>x86_64</string>' \
	  '				<key>BundlePath</key>' \
	  '				<string>MyIntelGPU.kext</string>' \
	  '				<key>Comment</key>' \
	  '				<string>MyIntelGPU Gen12-5.0 (0xA7AC - ICL Metal Hook, No Bundle)</string>' \
	  '				<key>Enabled</key>' \
	  '				<true/>' \
	  '				<key>ExecutablePath</key>' \
	  '				<string>Contents/MacOS/MyIntelGPU</string>' \
	  '				<key>MaxKernel</key>' \
	  '				<string></string>' \
	  '				<key>MinKernel</key>' \
	  '				<string>22.0.0</string>' \
	  '				<key>PlistPath</key>' \
	  '				<string>Contents/Info.plist</string>' \
	  '			</dict>' \
	  '		</array>' \
	  '		<key>Quirks</key>' \
	  '		<dict>' \
	  '			<key>DisableLinkeditJettison</key>' \
	  '			<true/>' \
	  '		</dict>' \
	  '	</dict>' \
	  '	<key>NVRAM</key>' \
	  '	<dict>' \
	  '		<key>Add</key>' \
	  '		<dict>' \
	  '			<key>7C436110-AB2A-4BBB-A880-FE41995C9F82</key>' \
	  '			<dict>' \
	  '				<key>boot-args</key>' \
	  '				<string>-v keepsyms=1 debug=0x100 -wegnoigpu</string>' \
	  '			</dict>' \
	  '		</dict>' \
	  '	</dict>' \
	  '</dict>' \
	  '</plist>' > "$(OC_STAGE)/EFI/OC/config-MyIntelGPU.plist"
	@plutil -lint "$(OC_STAGE)/EFI/OC/config-MyIntelGPU.plist"
	@plutil -lint "$(OC_STAGE)/EFI/OC/Kexts/$(TARGET).kext/Contents/Info.plist"
	@printf '%s\n' \
	  '#!/bin/bash' \
	  'set -e' \
	  'cd "$$(dirname "$$0")"' \
	  'if [ ! -d "/Volumes/EFI/EFI/OC/Kexts" ]; then' \
	  '    echo "Mount EFI partition to /Volumes/EFI first (e.g. sudo diskutil mount disk0s1)"' \
	  '    exit 1' \
	  'fi' \
	  'rm -rf "/Volumes/EFI/EFI/OC/Kexts/MyIntelGPU.kext"' \
	  'cp -R "EFI/OC/Kexts/MyIntelGPU.kext" "/Volumes/EFI/EFI/OC/Kexts/"' \
	  'if [ -f "EFI/OC/ACPI/SSDT-MyIntelGPU.aml" ]; then' \
	  '    cp -f "EFI/OC/ACPI/SSDT-MyIntelGPU.aml" "/Volumes/EFI/EFI/OC/ACPI/"' \
	  'fi' \
	  'xattr -cr "/Volumes/EFI/EFI/OC/Kexts/MyIntelGPU.kext"' \
	  'echo "Installed MyIntelGPU.kext (No Bundle) into /Volumes/EFI/EFI/OC/Kexts/"' \
	  'echo "Merge settings from EFI/OC/config-MyIntelGPU.plist into your EFI/OC/config.plist."' \
	  > "$(OC_STAGE)/install-to-opencore.command"
	@chmod +x "$(OC_STAGE)/install-to-opencore.command"
	@OC_VER=$$(/usr/libexec/PlistBuddy -c "Print :CFBundleVersion" "$(OC_STAGE)/EFI/OC/Kexts/$(TARGET).kext/Contents/Info.plist") && \
	 OC_ZIP="$(TARGET)-OpenCore-$$OC_VER.zip" && \
	 rm -f "$$OC_ZIP" && \
	 ditto -c -k --sequesterRsrc --keepParent "$(OC_STAGE)" "$$OC_ZIP" && \
	 ls -lh "$$OC_ZIP" && \
	 echo "--- Built OpenCore Suite: $$OC_ZIP ---"

# ─── Binary Stripping ─────────────────────────────────────────────
strip_binary:
	@echo "Stripping symbols from binary..."
	strip -x -S $(TARGET).kext/Contents/MacOS/$(TARGET)
	@ls -la $(TARGET).kext/Contents/MacOS/$(TARGET)
	@echo "Binary stripped. Symbols removed for distribution."

# ─── File Size Check ──────────────────────────────────────────────
sizecheck:
	@maxsize=230000; \
	actual=$$(stat -f%z "$(TARGET).kext/Contents/MacOS/$(TARGET)" 2>/dev/null || echo 0); \
	if [ "$$actual" -gt "$$maxsize" ]; then \
		echo "WARNING: Binary $$actual bytes exceeds $$maxsize - check for bloat"; exit 1; \
	else \
		echo "Size check: $$actual bytes (limit $$maxsize) - OK"; \
	fi
