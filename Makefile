# Makefile — MyIntelGPU Thin Bridge Edition (Based on Verified Native Makefile)
SIZE_BUDGET := 190000
TARGET      := MyIntelGPU
CLASS       := MyIntelGPU

SDK_DIR ?= $(HOME)/MacKernelSDK
ifneq ($(KERNEL_SDK_DIR),)
    SDK_DIR := $(KERNEL_SDK_DIR)
endif

ifeq ($(wildcard $(SDK_DIR)/Headers/IOKit/IOService.h),)
    ifneq ($(wildcard /opt/MacKernelSDK/Headers/IOKit/IOService.h),)
        SDK_DIR := /opt/MacKernelSDK
    else
        SDK_DIR := $(shell xcrun --show-sdk-path 2>/dev/null)
    endif
endif

ifeq ($(wildcard $(SDK_DIR)/Headers/IOKit/IOService.h),)
    USE_MKS :=
    SDK_XCRUN := $(SDK_DIR)
else
    USE_MKS := 1
    SDK_XCRUN := $(shell xcrun --show-sdk-path 2>/dev/null)
endif

BASE_VERSION := $(shell /usr/libexec/PlistBuddy -c "Print :CFBundleVersion" Info.plist 2>/dev/null)
BASE_VERSION_OK := $(shell printf '%s' "$(BASE_VERSION)" | grep -cE '^[0-9]+(\.[0-9]+)*$$')
ifeq ($(BASE_VERSION_OK),0)
$(error FATAL: cannot read CFBundleVersion from Info.plist (got '$(BASE_VERSION)'))
endif

PATCH_NUM := $(shell printf '%s' "$(BASE_VERSION)" | awk -F. '{print $$3}')
PATCH_NUM_OK := $(shell printf '%s' "$(PATCH_NUM)" | grep -cE '^[0-9]+$$')
ifeq ($(PATCH_NUM_OK),0)
    BUILD_NUMBER ?= 0
else
    BUILD_NUMBER ?= $(PATCH_NUM)
endif
STAMPED_VERSION := $(shell echo "$(BASE_VERSION).0.0" | awk -F. '{m=$$1?$$1:1; n=$$2?$$2:0; print m"."n}').$(BUILD_NUMBER)

MyIntelGPUVersion.h: FORCE
	@printf '/* Generated by Makefile — do not edit. */\n#pragma once\n#define MYINTELGPU_BUNDLE_VERSION "%s"\n' "$(STAMPED_VERSION)" > $@.tmp
	@cmp -s $@.tmp $@ || mv $@.tmp $@
	@rm -f $@.tmp

ifeq ($(USE_MKS),1)
KERNEL_HEADERS = -I$(SDK_DIR)/Headers -I$(SDK_XCRUN)/usr/include
KMOD_LIB       = $(SDK_DIR)/Library/x86_64/libkmod.a
else
KERNEL_HEADERS = -I$(SDK_XCRUN)/System/Library/Frameworks/Kernel.framework/Headers -I$(SDK_XCRUN)/usr/include
KMOD_LIB       =
endif

CXXFLAGS = -std=c++14 \
           -mkernel \
           -fapple-kext \
           -mmacosx-version-min=12.0 \
           -arch x86_64 \
           -Oz \
           -flto \
           -ffunction-sections \
           -fdata-sections \
           -nostdlib \
           -fno-builtin \
           -fno-exceptions \
           -fno-rtti \
           -fno-stack-protector \
           -fno-unwind-tables \
           -fno-asynchronous-unwind-tables \
           -fomit-frame-pointer \
           -D_FORTIFY_SOURCE=0 \
           -DKERNEL \
           -D__STRICT_BSD__ \
           -Wno-deprecated-declarations \
           -Wno-inconsistent-missing-override \
           $(KERNEL_HEADERS)

ifneq ($(MYINTEL_DEBUG),)
CXXFLAGS += -DMYINTEL_DEBUG
endif

LDFLAGS = -flto \
          -Xlinker -kext \
          -Xlinker -dead_strip \
          -Xlinker -x \
          -Xlinker -exported_symbols_list \
          -Xlinker $(CURDIR)/exported_symbols.txt

# ใช้รายการไฟล์ที่มีอยู่จริงแล้วให้ -flto + -dead_strip ตัดฟังก์ชันที่ไม่มีใครเรียกออกอัตโนมัติ
ALL_CANDIDATES = MyIntelGPU.cpp IntelFramebuffer.cpp MyIntelFramebuffer.cpp \
                 MyIntelAccelerator.cpp MyIntelMedia.cpp \
                 MyIntelRing.cpp MyIntelGEMBuffer.cpp MyIntelGPUClient.cpp \
                 MyIntelVCSCommand.cpp MyIntelVCSClient.cpp \
                 MyIntelEDIDParser.cpp
SRC := $(wildcard $(ALL_CANDIDATES))
OBJ := $(SRC:.cpp=.o)

.PHONY: all clean version FORCE
.DEFAULT_GOAL := all

all: $(TARGET).kext/Contents/MacOS/$(TARGET)
	@rm -rf "$(TARGET).kext/Contents/PlugIns"

$(OBJ): MyIntelGPUVersion.h

%.o: %.cpp
	$(CC) $(CXXFLAGS) -c -o $@ $<

$(TARGET).kext/Contents/Info.plist: Info.plist FORCE
	mkdir -p "$(TARGET).kext/Contents"
	cp Info.plist "$@"
	/usr/libexec/PlistBuddy -c "Set :CFBundleVersion $(STAMPED_VERSION)" "$@"
	/usr/libexec/PlistBuddy -c "Set :CFBundleShortVersionString $(STAMPED_VERSION)" "$@"

$(TARGET).kext/Contents/MacOS/$(TARGET): $(OBJ) $(TARGET).kext/Contents/Info.plist
	mkdir -p "$(TARGET).kext/Contents/MacOS"
	$(CC) $(CXXFLAGS) $(LDFLAGS) -o "$@" $(OBJ) $(if $(wildcard $(KMOD_LIB)),$(KMOD_LIB))
	strip -x -S "$@"
	@actual=$$(stat -f%z "$@"); \
	echo "─── Thin Bridge Build: $(TARGET).kext [$(STAMPED_VERSION)] $$actual bytes ───"; \
	if [ "$$actual" -gt $(SIZE_BUDGET) ]; then \
		echo "WARNING: binary $$actual bytes > $(SIZE_BUDGET)"; \
	fi

version:
	@echo "Stamped version: $(STAMPED_VERSION)"

clean:
	rm -rf $(TARGET).kext $(OBJ) MyIntelGPUVersion.h
